{
    "extends":  "./tsconfig.base.json",
    "compilerOptions":  {
                            "baseUrl":  ".",
                            "paths":  {
                                          "@/*":  [
                                                      "./*"
                                                  ]
                                      },
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "es2022"
                                    ],
                            "allowJs":  false,
                            "noEmit":  true,
                            "incremental":  true,
                            "jsx":  "preserve",
                            "moduleResolution":  "Bundler",
                            "types":  [
                                          "node"
                                      ],
                            "isolatedModules":  true,
                            "plugins":  [
                                            {
                                                "name":  "next"
                                            }
                                        ]
                        },
    "include":  [
                    "next-env.d.ts",
                    "**/*.ts",
                    "**/*.tsx",
                    ".next/types/**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "apps/frontend/**/*"
                ]
}
